# ==============================================================================
# Oficina Gestão — Exemplo de Variáveis de Ambiente (Desenvolvimento Local)
# ==============================================================================
# NUNCA insira credenciais reais neste arquivo.
# Copie este arquivo para .env (que é ignorado pelo Git) e preencha seus dados:
# cp .env.example .env
# ==============================================================================

# Conexão com o Banco de Dados PostgreSQL (Neon)
DB_URL=jdbc:postgresql://<neon-hostname>.neon.tech/<database_name>?sslmode=require
DB_USERNAME=seu_usuario_neon
DB_PASSWORD=sua_senha_neon

# Configurações do Backend Spring Boot
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Segurança e JWT (Segredo de 256 bits / 32+ caracteres)
JWT_SECRET=sua_chave_secreta_jwt_de_pelo_menos_32_caracteres_hex_ou_string
JWT_EXPIRATION_MS=86400000

# Bootstrap da Conta Inicial da Proprietária (Executado apenas se a tabela usuarios estiver vazia)
INITIAL_ADMIN_NAME=Proprietária Oficina
INITIAL_ADMIN_EMAIL=admin@oficina.com
INITIAL_ADMIN_PASSWORD=sua_senha_segura_aqui
