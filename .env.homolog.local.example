# Configuração privada do Neon PostgreSQL de homologação.
# Copie este modelo para .env.homolog.local e preencha SOMENTE o arquivo privado.
# Projeto existente oficina-homologacao, branch production; audite isolamento antes de habilitar.
# Use SOMENTE uma senha NOVA após rotação. Não copie a senha de mensagens/imagens.
# Codifique caracteres especiais de usuário/senha com percent-encoding.
NEON_HML_URL=postgresql://oficina_security_test_owner:CHANGE_ME_NEW_PASSWORD@ep-CHANGE-ME.c-2.sa-east-1.aws.neon.tech/oficina_security_test?sslmode=verify-full&channel_binding=require
NEON_HML_EXPECTED_HOST=CHANGE_ME.neon.tech
NEON_HML_ISOLATED=false
NEON_HML_CREDENTIAL_ROTATED=false
NEON_HML_PROJECT=oficina-homologacao
NEON_HML_BRANCH=production
NEON_HML_PROJECT_ISOLATED=false
# Para outro nome terminado em _security_test, aprove explicitamente o nome exato:
NEON_HML_APPROVED_DATABASE=
# Opcionais, preenchidos apenas no arquivo privado para preparar Secret Manager:
MAIL_PASSWORD=
INITIAL_ADMIN_PASSWORD=
