# Metadados e controles privados de homologação. Copie para .env.cloud.homolog.local.
HML_PROJECT=oficinagestao-homologacao
HML_PROJECT_NUMBER=193690344577
HML_REGION=us-central1
HML_ISOLATED=false
HML_BACKEND_SERVICE=oficina-backend-hml
HML_FRONTEND_SERVICE=oficina-frontend-hml
HML_FRONTEND_SERVICE_ACCOUNT=oficina-frontend-hml@oficinagestao-homologacao.iam.gserviceaccount.com
HML_DENIED_SERVICE_ACCOUNT=oficina-denied-hml@oficinagestao-homologacao.iam.gserviceaccount.com
HML_EXPECTED_PROXY_HOPS=CHANGE_ME_AFTER_MEASURING_FIREBASE_INGRESS
HML_HOSTING_PUBLICATION_APPROVED=false
# Sem segredos. Preencha digests e versões somente após verificação remota.
HML_BACKEND_IMAGE=CHANGE_ME_APPROVED_DIGEST
HML_FRONTEND_IMAGE=CHANGE_ME_APPROVED_DIGEST
HML_DB_PASSWORD_VERSION=CHANGE_ME_NUMERIC_VERSION
HML_JWT_SECRET_VERSION=CHANGE_ME_NUMERIC_VERSION
HML_RATE_LIMIT_SECRET_VERSION=CHANGE_ME_NUMERIC_VERSION
HML_SERVICE_PROXY_SECRET_VERSION=CHANGE_ME_NUMERIC_VERSION
HML_MAIL_PASSWORD_VERSION=CHANGE_ME_NUMERIC_VERSION
HML_FIREBASE_SESSION_SECRET_VERSION=CHANGE_ME_NUMERIC_VERSION
