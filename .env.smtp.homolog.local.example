# SMTP sandbox exclusivamente de homologação. Copie para .env.smtp.homolog.local.
HML_SMTP_ISOLATED=false
HML_SMTP_HOST=CHANGE_ME_SANDBOX_HOST
HML_SMTP_PORT=587
HML_SMTP_USERNAME=CHANGE_ME_SANDBOX_USERNAME
HML_SMTP_PASSWORD=CHANGE_ME_NEW_SANDBOX_PASSWORD
MAIL_FROM=mailer-homolog@example.invalid
# Mapeamento backend: MAIL_HOST/PORT/USERNAME/FROM, MAIL_PASSWORD via Secret Manager.
# MAIL_SMTP_AUTH=true; MAIL_SMTP_STARTTLS=true; profile prod mantém STARTTLS obrigatório.
