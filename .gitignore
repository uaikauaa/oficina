# ==========================================
# Oficina Gestão — .gitignore Oficial
# ==========================================

# Ambientes e Segredos (NUNCA commitados)
.env
.env*.local
.env.development
.env.test
.env.production
*.pem
*.key
*.p12

# Node & Frontend (Next.js)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# Next.js Build Artifacts
frontend/.next/
frontend/out/
frontend/build/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Java & Backend (Maven / Spring Boot)
backend/target/
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven Wrapper runtime
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Logs
*.log
logs/
backend/logs/

# IDEs & Editores
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
bin/

# Sistema Operacional
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# Coverage e Testes
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
blob-report/
playwright/.cache/
