# Exemplo somente. Copiar para /etc/oficina/backup.env (0640, root:oficina-backup).
# NUNCA versionar credenciais nem colar aqui dados de producao.
# Usar hostname DIRETO (sem -pooler), Neon via TLS com hostname verificavel.
BACKUP_DB_HOST='ep-EXEMPLO.sa-east-1.aws.neon.tech'
BACKUP_DB_PORT='5432'
BACKUP_DB_NAME='neondb'
BACKUP_DB_USER='USUARIO_BACKUP_SOMENTE_LEITURA'
BACKUP_DB_PASSWORD='CHANGE_ME'
# Criar chave age offline e guardar identidade de decriptacao fora do servidor.
BACKUP_AGE_RECIPIENT='age1SUBSTITUIR'
# R2, S3 ou compativel: endpoint HTTPS real e bucket privado.
BACKUP_S3_ENDPOINT='https://CHANGE_ME.r2.cloudflarestorage.com'
BACKUP_BUCKET='CHANGE_ME'
BACKUP_PREFIX='oficina-production'
AWS_ACCESS_KEY_ID='CHANGE_ME'
AWS_SECRET_ACCESS_KEY='CHANGE_ME'
AWS_DEFAULT_REGION='auto'
