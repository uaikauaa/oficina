# Modelo de homologação isolada em dois serviços Cloud Run.
# Distribua somente as variáveis da seção correspondente a cada serviço.
# Valores CHANGE_ME são placeholders; use Secret Manager para os segredos.

# Backend privado (IAM)
SPRING_PROFILES_ACTIVE=prod
SECURITY_COOKIE_SECURE=true
APP_PUBLIC_URL=https://frontend-homolog.example.invalid
DB_URL=jdbc:postgresql://HOST-HOMOLOG.example.invalid/DB-HOMOLOG?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
DB_USERNAME=CHANGE_ME_HOMOLOG_ONLY
DB_PASSWORD=CHANGE_ME_SECRET_MANAGER
JWT_SECRET=CHANGE_ME_INDEPENDENT_RANDOM_32_BYTES
RATE_LIMIT_SECRET=CHANGE_ME_DIFFERENT_RANDOM_32_BYTES
INVITE_OUTBOX_KEYS=1:CHANGE_ME_BASE64_OF_SEPARATE_RANDOM_32_BYTES
INVITE_OUTBOX_ACTIVE_VERSION=1
PASSWORD_RECOVERY_EXPIRATION_MINUTES=30
SERVICE_PROXY_SECRET=CHANGE_ME_THIRD_RANDOM_32_BYTES
CORS_ALLOWED_ORIGINS=https://frontend-homolog.example.invalid
MAIL_HOST=smtp-homolog.example.invalid
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_HOMOLOG_ONLY
MAIL_PASSWORD=CHANGE_ME_SECRET_MANAGER
MAIL_FROM=mailer-homolog@example.invalid
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
SWAGGER_ENABLED=false
API_DOCS_ENABLED=false
INITIAL_ADMIN_NAME=Administrador Sintetico
INITIAL_ADMIN_EMAIL=admin@example.invalid
INITIAL_ADMIN_PASSWORD=CHANGE_ME_INDEPENDENT_BOOTSTRAP_SECRET_MANAGER
# Remove the bootstrap password reference after creating the synthetic account.

# Frontend público (somente estes valores; nunca DB_*, JWT_SECRET ou MAIL_PASSWORD)
INTERNAL_BACKEND_URL=https://backend-homolog.example.invalid
CLOUD_RUN_IAM=true
SERVICE_PROXY_SECRET=CHANGE_ME_SAME_SECRET_AS_BACKEND_CONTEXT
TRUSTED_PROXY_HOPS=CHANGE_ME_AFTER_VALIDATING_INGRESS
INFRA_DATABASE_PROVIDER=local
INFRA_CACHE_TTL_SECONDS=120
NEON_PROJECT_ID=
NEON_API_KEY=
SUPER_ADMIN_BOOTSTRAP_EMAIL=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_RUN_SERVICE=
