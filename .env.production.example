# Modelo para futura produção. NÃO aprovado para uso antes da homologação.
# Configure segredos pelo Secret Manager, não em arquivo versionado.
# Distribua DB_*, JWT_SECRET, RATE_LIMIT_SECRET e MAIL_* só ao backend;
# ao frontend, somente INTERNAL_BACKEND_URL, SERVICE_PROXY_SECRET e TRUSTED_PROXY_HOPS.
# HTTP_PORT permanece apenas para o modo Oracle/VPS legado.
HTTP_PORT=80
SPRING_PROFILES_ACTIVE=prod
SECURITY_COOKIE_SECURE=true

DB_URL=jdbc:postgresql://HOST.example.invalid/DB_NAME?sslmode=verify-full
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_AT_DEPLOY_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RATE_LIMIT_SECRET=CHANGE_ME_WITH_A_DIFFERENT_RANDOM_32_BYTE_RATE_KEY
SERVICE_PROXY_SECRET=CHANGE_ME_WITH_A_THIRD_INDEPENDENT_RANDOM_32_BYTE_KEY
CORS_ALLOWED_ORIGINS=https://app.example.invalid
# Somente frontend Cloud Run: origem HTTPS do backend privado.
INTERNAL_BACKEND_URL=https://backend.example.invalid
TRUSTED_PROXY_HOPS=CHANGE_ME_AFTER_VALIDATING_INGRESS
CLOUD_RUN_IAM=true

MAIL_HOST=smtp.example.invalid
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=mailer@example.invalid
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_CONNECTION_TIMEOUT=15000
MAIL_READ_TIMEOUT=25000
MAIL_WRITE_TIMEOUT=25000

# Seed usado somente quando a tabela usuarios estiver vazia.
# Remova estes tres valores do ambiente depois do bootstrap inicial bem-sucedido.
INITIAL_ADMIN_NAME=CHANGE_ME
INITIAL_ADMIN_EMAIL=admin@example.invalid
INITIAL_ADMIN_PASSWORD=CHANGE_ME

SECURITY_JWT_REFRESH_EXPIRATION_TEMP_MS=86400000
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2
HIKARI_MAX_LIFETIME=600000
HIKARI_IDLE_TIMEOUT=300000
HIKARI_CONN_TIMEOUT=20000
HIKARI_KEEPALIVE_TIME=120000
